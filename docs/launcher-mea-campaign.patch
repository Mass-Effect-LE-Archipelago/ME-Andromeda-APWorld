+    // Mass Effect Andromeda: install the world and stage an ordered Frosty mod set. Nothing in the game folder is
+    // touched; the staged mods live in the state folder until the launcher's own Frosty loader applies them.
+    void InstallFrostyMods(Options options)
+    {
+        if (!ArchipelagoFound) throw new InvalidOperationException("Set the Archipelago folder on page 1.");
+        RequireArchipelagoClosed(ApDir);
+        Directory.CreateDirectory(StateDir);
+        _manifest = LoadManifest();
+        if (_manifest.GameDir != null && !SameFolder(_manifest.GameDir, GameDir) || _manifest.ApDir != null && !SameFolder(_manifest.ApDir, ApDir))
+            throw new InvalidOperationException($"{Profile.Title} is installed into other folders ({_manifest.GameDir}, {_manifest.ApDir}): Uninstall first.");
+        _manifest.GameDir = Path.GetFullPath(GameDir);
+        _manifest.ApDir = Path.GetFullPath(ApDir);
+        SaveManifest();
+
+        Place(WorldTarget, Path.Combine(Payload, Profile.Apworld));
+        var modsJson = Path.Combine(Payload, "mods.json");
+        Place(Path.Combine(StateDir, "mods.json"), modsJson);
+
+        var inventory = MeaProfile.ReadInventory(modsJson);
+        var profilePath = Path.Combine(StateDir, "mods-profile.json");
+        var profile = File.Exists(profilePath) ? MeaProfile.Load(profilePath) : MeaProfile.Create(inventory, Payload);
+        profile.Save(profilePath);
+        var result = profile.Deploy(inventory, Path.Combine(Payload, "mods"), Path.Combine(StateDir, "mods"));
+        Log.AddRange(result.Lines);
+        SaveManifest();
+        Log.Add("World installed and the mod set staged.");
+        Log.Add("Applying the mod set to the game is not automatic yet (the launcher's Frosty loader is still being built). " +
+                "Until then, load the staged .fbmod files in Frosty Mod Manager, in the same order.");
+    }
+
+    List<string> FrostyLaunchProblems()
+    {
+        var problems = new List<string>();
+        if (!GameFound) problems.Add("Mass Effect Andromeda not found (set its folder on page 1).");
+        if (!ArchipelagoFound) problems.Add("Archipelago not found (set its folder on page 1).");
+        if (problems.Count > 0) return problems;
+        if (Hash(Path.Combine(Payload, Profile.Apworld)) != Hash(WorldTarget))
+            problems.Add("The Archipelago world is missing or a different version: Install / Repair.");
+        if (!File.Exists(Path.Combine(StateDir, "mods", MeaProfile.ManifestName)))
+            problems.Add("The mod set is not staged: Install / Repair.");
+        return problems;
+    }
+
